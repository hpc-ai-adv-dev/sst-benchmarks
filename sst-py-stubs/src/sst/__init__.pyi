    def setCoordinates(self, x: float, y: float = 0.0, z: float = 0.0) -> None: ...
    @overload
    def setCoordinates(self, coords: list[float] | tuple[float, ...]) -> None: ...

    def setCoordinates(
        self,
        x: float | list[float] | tuple[float, ...],
        y: float = 0.0,
        z: float = 0.0,
    ) -> None:
        """Set x, y, and z coordinates for this element.

        This is for use with visualization.

        Parameters
        ----------
        x : float | list[float] | tuple[float, ...]
            Either the x position of the element or a sequence containing the
            coordinate values.
        y : float, default=0.0
            Y position of the element when coordinates are passed separately.
        z : float, default=0.0
            Z position of the element when coordinates are passed separately.

        Returns
        -------
        None
        """
        ...

    def addSharedParamSet(self, set_name: str) -> None:
        """Add a shared parameter set to a component's parameters.

        Using shared parameter sets reduces memory overhead and is helpful when
        simulating very large systems where many elements have a common
        parameter subset. Parameters set directly on a component take
        precedence if there is a conflict.

        Parameters
        ----------
        set_name : str
            Name of the shared parameter set. The name must be registered with
            SST using ``sst.addSharedParams()``.

        Returns
        -------
        None
        """
        ...

    def addGlobalParamSet(self, set_name: str) -> None:
        """Add a deprecated global parameter set to a component's parameters.

        ``GlobalParam`` was renamed to ``SharedParam`` in SST 15.0 to better
        reflect the shared rather than strictly global nature of these
        parameter sets. Parameters set directly on a component take precedence
        over values provided in the global parameter set.

        Parameters
        ----------
        set_name : str
            Name of the global parameter set. The name must be registered with
            SST using ``sst.addGlobalParams()``.

        Returns
        -------
        None
        """
        ...


ComponentLike = Component | SubComponent
"""Component-like objects accepted by several SST APIs."""

Endpoint = tuple[ComponentLike, str] | tuple[ComponentLike, str, Latency]
"""Tuple form accepted by Link.connect() and Link.connectNonLocal()."""


class Link:
    """Create and connect Links between SST component ports.

    A Link connects two ports and enables the components on each port to send
    events across the link. Creating a Link does not connect it; it must still
    be connected to ports via Link.connect() or Component.addLink() /
    SubComponent.addLink().
    """

    def __init__(self, name: str, latency: Latency | None = None) -> None:
        """Create a Link.

        A Link connects two ports and enables the components on each port to
        send events across the link.

        Parameters
        ----------
        name : str
            Unique, user-defined name for the link.
        latency : str | UnitAlgebra | None, optional
            Default latency for the link. This is used if no latency is
            specified in subsequent calls to Link.connect() or
            Component.addLink() / SubComponent.addLink().

        Returns
        -------
        None
            Creates a Link object.
        """
        ...

    def connect(self, endpoint0: Endpoint, endpoint1: Endpoint) -> None:
        """Connect two ports using the link object.

        Each endpoint tuple contains a Component or SubComponent handle, a
        port name, and optionally a latency value from the perspective of that
        endpoint sending an event.

        Parameters
        ----------
        endpoint0 : Endpoint
            Tuple describing the first endpoint as ``(comp, port)`` or
            ``(comp, port, latency)``.
        endpoint1 : Endpoint
            Tuple describing the second endpoint as ``(comp, port)`` or
            ``(comp, port, latency)``.

        Returns
        -------
        None
        """
        ...

    def connectNonLocal(self, endpoint: Endpoint, location: tuple[int, int]) -> None:
        """Connect one local endpoint and mark the other endpoint as non-local."""
        ...

    def setNonLocal(self, rank: int, thread: int) -> None:
        """Mark the link as connected to a non-local rank and thread."""
        ...

    def setNoCut(self) -> None:
        """Tell the simulator that this link should not be cut by a partition boundary.

        This guarantees that the two Components connected by this link will be
        placed on the same rank when using an automatic partitioning scheme.
        This attribute is ignored if the self partitioner is used.

        Returns
        -------
        None
        """
        ...


class StatisticGroup:
    """Create and parameterize a group of statistics.

    Statistic groups write through a shared StatisticOutput.
    """

    def __init__(self, name: str) -> None:
        """Create a StatisticGroup object.

        Parameters
        ----------
        name : str
            Name of the group.

        Returns
        -------
        None
            Creates a StatisticGroup object.
        """
        ...

    def addStatistic(self, stat: str, stat_params_dict: Params | None = None) -> None:
        """Add a statistic to the group.

        The specified statistic name must exist in all components that are
        part of the group.

        Parameters
        ----------
        stat : str
            Name of the statistic to add to the group.
        stat_params_dict : dict[str, Any] | None, optional
            Dictionary specifying the statistic parameters.

        Returns
        -------
        None
        """
        ...

    def addComponent(self, comp: ComponentLike) -> None:
        """Add a Component or SubComponent to the group.

        Adding a component does not add that component's statistics; those
        must be added separately with addStatistic().

        Parameters
        ----------
        comp : Component | SubComponent
            Component or SubComponent to add to the group.

        Returns
        -------
        None
        """
        ...

    def setOutput(self, output: StatisticOutput) -> None:
        """Configure how the statistics in the group should be written.

        Parameters
        ----------
        output : StatisticOutput
            StatisticOutput object that will record the data.

        Returns
        -------
        None
        """
        ...

    def setFrequency(self, interval: str) -> None:
        """Set the frequency or rate used to write out the statistics.

        Time refers to simulated time. A rate of ``0ns`` causes output to be
        written only at the completion of simulation.

        Parameters
        ----------
        interval : str
            Interval at which statistics should be written.

        Returns
        -------
        None
        """
        ...


